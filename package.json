{
  "name": "patrimo",
  "version": "0.11.9",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "description": "Application locale de suivi de patrimoine : lit un Excel comme source de vérité, récupère les cours en ligne et calcule positions, PRU et P&L.",
  "author": {
    "name": "Bastien Ostalowski",
    "email": "REDACTED"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"packages/core/src/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p mobile/tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify-full": "npm run verify && npm run e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "branch-contract": "bash scripts/branch-contract.sh",
    "branch-status": "bash scripts/branch-status.sh",
    "branch-ready": "bash scripts/branch-ready.sh",
    "platform-gaps": "bash scripts/platform-gaps.sh",
    "next-feature": "bash scripts/next-feature.sh",
    "cold-start": "bash scripts/cold-start-check.sh",
    "red": "bash scripts/red-evidence.sh",
    "gauntlet": "bash scripts/gauntlet.sh",
    "pr-check": "bash scripts/pr-check.sh",
    "flow": "bash scripts/flow-status.sh",
    "checker": "bash scripts/role-worktree.sh checker",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n next,electron -c blue,green \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder --mac --config electron-builder.yml",
    "electron:pack": "next build && electron-builder --mac --dir --config electron-builder.yml"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.10"
  }
}
